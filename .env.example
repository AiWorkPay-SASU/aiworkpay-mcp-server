# Base URL of the AIWorkPay deployment (Aiworkpay-v2), without trailing slash
AIWORKPAY_BASE_URL=https://aiworkpay.fr
# The agent's API key (awp_...), generated by an AIWorkPay admin. One key = one agent.
AIWORKPAY_API_KEY=awp_your_agent_key

# Safety limits applied by the MCP server before any call to AIWorkPay
AIWORKPAY_MAX_MISSION_BUDGET=50
AIWORKPAY_ALLOWED_CURRENCIES=EUR
AIWORKPAY_REQUIRE_CONFIRMATION=true
AIWORKPAY_MAX_CREATIONS_PER_HOUR=10
AIWORKPAY_TIMEOUT_MS=15000
